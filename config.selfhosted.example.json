{
  "server_name": "My Valheim Server",
  "poll_interval_seconds": 15,
  "state_file": "monitor_state.json",
  "offline_grace_seconds": 300,
  "events": [
    "login",
    "logout",
    "death",
    "server_restart",
    "server_online",
    "server_offline",
    "raid",
    "version_mismatch",
    "session_summary",
    "welcome",
    "milestone",
    "weekly_recap",
    "update"
  ],
  "database": {
    "path": "valheim_stats.db",
    "enabled": true
  },
  "discord": {
    "username": "Valheim",
    "embeds": true,
    "show_player_count": true
  },
  "admin_bot": {
    "enabled": true,
    "guild_id": "123456789012345678",
    "channel_id": "123456789012345678",
    "admin_user_ids": [
      "123456789012345678"
    ],
    "admin_role_ids": [],
    "save_dir": "/valheim_save_data",
    "repeat_cooldown_seconds": 600,
    "status_channel": {
      "channel_id": "123456789012345678",
      "online": "🟢 Valheim: {count} online",
      "empty": "🟢 Valheim: empty",
      "offline": "🔴 Valheim: offline"
    },
    "status_board": {
      "channel_id": "123456789012345678"
    }
  },
  "steam": {
    "enabled": false,
    "api_key": "",
    "refresh_seconds": 1800,
    "top_n": 25
  },
  "maintenance": {
    "enabled": false
  },
  "backups": {
    "source_dir": "/valheim_save_data/worlds_local",
    "dest_dir": "/backups",
    "keep": 30,
    "alert_after_hours": 48
  },
  "weekly_recap": {
    "day": "sunday",
    "hour": 18
  },
  "updater": {
    "log": "/valheim_home/update_check.log",
    "bot_dir": "/bot"
  },
  "source": {
    "type": "file",
    "path": "/logs/valheim_console.log"
  }
}

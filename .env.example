# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.
#   cp .env.example .env && chmod 600 .env
# No quotes, no spaces around "=". Recreate the container after editing:
#   docker compose up -d --force-recreate

# Discord channel → Edit Channel → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Admin bot token: Discord developer portal → your app → Bot → Reset Token
# (~70 characters with two dots; NOT the OAuth2 Client Secret)
DISCORD_BOT_TOKEN=

# Your time zone, so times line up with the server's log
TZ=America/Los_Angeles

# Optional
# STEAM_API_KEY=

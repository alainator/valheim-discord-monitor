{
  "server_name": "My Valheim Server",
  "poll_interval_seconds": 15,
  "state_file": "monitor_state.json",
  "offline_grace_seconds": 300,
  "events": [
    "player_joined",
    "player_left",
    "server_online",
    "server_offline"
  ],
  "log_archive": {
    "enabled": true,
    "keep_days": 0
  },
  "database": {
    "path": "valheim_stats.db",
    "enabled": true
  },
  "stats_site": {
    "output": "/var/www/valheimstats/index.html",
    "render_interval_seconds": 60,
    "refresh_seconds": 120,
    "top_n": 10,
    "timezone_label": "server time"
  },
  "discord": {
    "webhook_url": "https://discord.com/api/webhooks/XXXX/YYYY",
    "username": "Huginn",
    "embeds": true,
    "show_player_count": true,
    "digest_seconds": 0,
    "quiet_hours": {},
    "messages": {
      "login": "**{player}** has arrived in {server}.",
      "logout": "**{player}** has left {server}.",
      "death": "**{player}** has died. Odin is watching.",
      "respawn": "**{player}** has respawned.",
      "server_restart": "**{server}** is restarting — all players have been disconnected.",
      "server_online": "**{server}** is back online!",
      "server_offline": "**{server}** is offline — it went down and hasn't come back.",
      "player_joined": "{who} arrived in {server}. **{count}/{max}** online.",
      "player_left": "{who} left {server}. **{count}/{max}** online.",
      "server_up": "{server} is online."
    }
  },
  "admin_bot": {
    "enabled": false,
    "token": "YOUR-BOT-TOKEN-OR-USE-DISCORD_BOT_TOKEN-ENV",
    "guild_id": "YOUR-DISCORD-SERVER-ID",
    "channel_id": "YOUR-PRIVATE-ADMIN-CHANNEL-ID",
    "admin_user_ids": [
      "YOUR-DISCORD-USER-ID"
    ],
    "admin_role_ids": [],
    "save_dir": "/home/valheim/valheim_save_data",
    "repeat_cooldown_seconds": 600,
    "status_channel": {
      "channel_id": "YOUR-STATUS-VOICE-CHANNEL-ID",
      "online": "🟢 Valheim: {count} online",
      "empty": "🟢 Valheim: empty",
      "offline": "🔴 Valheim: offline"
    },
    "status_board": {
      "channel_id": "YOUR-STATUS-BOARD-TEXT-CHANNEL-ID"
    },
    "join": {
      "address": "YOUR.PUBLIC.IP:2456",
      "note": "New here? Ask in #general to be added to the server."
    },
    "online_role": true,
    "owner_role": true,
    "link_nickname": false,
    "tidy_notices_hours": 24,
    "welcome_dm": false,
    "runestone_news": false,
    "patch_notes": { "enabled": true, "public_test": false },
    "voice_lobby": false,
    "bounties": { "role": "Skadi", "role_days": 7 },
    "stat_channels": {
      "enabled": false
    },
    "lfg": {
      "reminder_minutes": 15,
      "discord_event": false
    },
    "map": {
      "enabled": true
    },
    "bosses": {
      "enabled": true,
      "announce": true
    },
    "titles": {
      "enabled": false,
      "period": "all",
      "day": "sunday",
      "hour": 18
    }
  },
  "steam": {
    "enabled": true,
    "api_key": "YOUR-STEAM-WEB-API-KEY-OR-USE-STEAM_API_KEY-ENV",
    "refresh_seconds": 1800,
    "top_n": 25
  },
  "maintenance": {
    "enabled": false,
    "api_key": "YOUR-lowms_-KEY-OR-USE-LOWMS_API_KEY-ENV",
    "check_interval_seconds": 900,
    "timezone": "America/Los_Angeles",
    "count_max_age_seconds": 780,
    "dry_run": false,
    "notify": true,
    "state_file": "maintenance_state.json",
    "update": {
      "enabled": true,
      "check_interval_seconds": 3600,
      "empty_settle_seconds": 180,
      "retry_cooldown_seconds": 3600
    },
    "backup": {
      "enabled": true,
      "window": "02:00-06:00",
      "stop_server": true,
      "delete_oldest_when_full": true
    },
    "panel_login": {
      "email": "you@example.com  (or NEXUS_EMAIL env)",
      "password": "your-panel-password  (or NEXUS_PASSWORD env)"
    }
  },
  "backups": {
    "source_dir": "/valheim_save_data/worlds_local",
    "dest_dir": "/backups",
    "keep": 30,
    "alert_after_hours": 48
  },
  "weekly_recap": {
    "day": "sunday",
    "hour": 18
  },
  "updater": {
    "log": "/valheim_home/update_check.log",
    "bot_dir": "/bot"
  },
  "health": {
    "low_disk_gb": 10,
    "slow_save_seconds": 5
  },
  "source": {
    "type": "a2s",
    "host": "YOUR.SERVER.IP",
    "port": 2457,
    "timeout": 3,
    "offline_after": 3
  },
  "_alternative_sources": {
    "lowms": {
      "type": "lowms",
      "server_id": "YOUR-SERVER-UUID",
      "api_key": "YOUR-lowms_-KEY-OR-USE-LOWMS_API_KEY-ENV",
      "lines": 300
    },
    "steamapi": {
      "type": "steamapi",
      "host": "YOUR.SERVER.IP",
      "game_port": 2456,
      "api_key": "YOUR-STEAM-WEB-API-KEY-OR-USE-STEAM_API_KEY-ENV",
      "offline_after": 3
    },
    "ftp": {
      "type": "ftp",
      "host": "YOUR.SERVER.IP",
      "port": 21,
      "user": "your-low.ms-login",
      "password": "your-low.ms-password",
      "path": "/game/valheim_console.log",
      "tls": false,
      "passive": true
    },
    "nexus": {
      "type": "nexus",
      "server_id": "YOUR-SERVER-UUID",
      "lines": 300,
      "login": {
        "email": "you@example.com  (or NEXUS_EMAIL env)",
        "password": "your-panel-password  (or NEXUS_PASSWORD env)"
      }
    },
    "file": {
      "type": "file",
      "path": "/path/to/valheim_console.log"
    },
    "sftp": {
      "type": "sftp",
      "host": "YOUR.SERVER.IP",
      "port": 22,
      "user": "user",
      "password": "password",
      "path": "/game/valheim_console.log"
    },
    "http": {
      "type": "http",
      "url": "https://example.com/valheim_console.log",
      "headers": {
        "Authorization": "Bearer ..."
      }
    }
  },
  "_log_mode_events": [
    "login",
    "logout",
    "death",
    "raid",
    "version_mismatch",
    "session_summary",
    "welcome",
    "milestone",
    "weekly_recap",
    "update",
    "achievement"
  ]
}
